{
  "name": "Telegram Bulk Number Profile",
  "brand": "AvatarLookup",
  "repository": "avatarlookup/telegram-bulk-number-profile-api",
  "description": "Upload numbers and download the Telegram profile data, avatar included.",
  "official_site": "https://avatarlookup.com",
  "landing_page": "https://avatarlookup.com/products/tg_profile_batch",
  "canonical_docs": "https://avatarlookup.com/api-docs",
  "base_url": "https://avatarlookup.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "tg_profile_batch",
  "identifier_kind": "phone",
  "requires_country": true,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 100000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "Phone",
      "example": "+17253100591",
      "description": ""
    },
    {
      "name": "activated",
      "example": "yes",
      "description": ""
    },
    {
      "name": "uid",
      "example": "123456789",
      "description": ""
    },
    {
      "name": "username",
      "example": "alexkim",
      "description": ""
    },
    {
      "name": "first_name",
      "example": "Alex",
      "description": ""
    },
    {
      "name": "last_name",
      "example": "Kim",
      "description": ""
    },
    {
      "name": "Last Online Time",
      "example": "2025/12/5 13:04",
      "description": ""
    },
    {
      "name": "Active Days",
      "example": "252",
      "description": ""
    },
    {
      "name": "Is Member",
      "example": "No",
      "description": ""
    },
    {
      "name": "Avatar",
      "example": "https://tg.waavatar.xyz/v/example.jpg",
      "description": ""
    },
    {
      "name": "Gender",
      "example": "Male",
      "description": ""
    },
    {
      "name": "Age",
      "example": "30",
      "description": ""
    },
    {
      "name": "Ethnicity",
      "example": "White",
      "description": ""
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://avatarlookup.com/pricing",
  "maintainer": "AvatarLookup",
  "license": "MIT",
  "last_reviewed": "2026-09-22"
}
